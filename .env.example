# Resend — transactionele e-mail
# Aanmaken op: https://resend.com/api-keys
# Vereist: domein aquaforce-cleaning.be verificeren onder Resend > Domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile — spam-bescherming
# Aanmaken op: https://dash.cloudflare.com > Turnstile
# Widget type: "Managed" (aanbevolen)
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...        # publiek, zichtbaar in browser
TURNSTILE_SECRET_KEY=0x4AAAAAAA...             # privé, alleen op server

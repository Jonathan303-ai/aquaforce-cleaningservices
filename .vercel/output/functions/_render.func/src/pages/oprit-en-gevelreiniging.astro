---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import InfoBar from '../components/InfoBar.astro';

import heroImg from '../assets/images/gevelreiniging-hero.webp';
import detail1 from '../assets/images/gevelreiniging-detail-1.webp';
import detail2 from '../assets/images/gevelreiniging-detail-2.webp';
---

<PageLayout
  title="Oprit & gevelreiniging in Bree en Limburg | Aquaforce Cleaning Services"
  description="Professionele reiniging van opritten, gevels, terrassen en verhardingen in Bree, Limburg en omliggende regio's. Verwijdering van mos, algen en aanslag met aangepaste drukreiniging."
>

  <!-- Hero met achtergrondafbeelding -->
  <section class="relative flex items-end overflow-hidden bg-navy-950" style="min-height: clamp(500px, 72vh, 700px);">

    <Image
      src={heroImg}
      alt="Professionele oprit- en gevelreiniging"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-bg-img absolute left-0 right-0 bottom-0 w-full select-none pointer-events-none"
      style="object-fit: cover; object-position: center top;"
    />

    <!-- Overlays — beeld zichtbaar bovenaan, tekst leesbaar onderaan -->
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-navy-950/82 via-navy-950/28 to-transparent"></div>
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-navy-950/50 via-navy-950/15 to-transparent"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full pt-36 pb-14 md:pt-44 md:pb-18">
      <nav aria-label="Breadcrumb" class="text-shadow-sm flex items-center gap-2 text-white text-sm mb-7">
        <a href="/" class="hover:text-slate-200 transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M6.293 12.707a1 1 0 010-1.414L9.586 8 6.293 4.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
        <span class="text-white">Oprit & gevelreiniging</span>
      </nav>
      <p class="text-shadow-sm text-water-400 font-display font-semibold text-xs tracking-[0.25em] uppercase mb-4">Dienst</p>
      <h1 class="text-shadow-hero font-display font-extrabold text-4xl md:text-5xl lg:text-6xl text-white leading-tight mb-5 max-w-2xl">
        Oprit & gevel&shy;reiniging
      </h1>
      <p class="text-shadow-sm text-white/90 text-lg leading-relaxed max-w-xl">
        Een verweerde gevel of bemoste oprit haalt het beeld van uw eigendom naar beneden.
        Wij geven uw buitenruimte haar oorspronkelijk aanzicht terug.
      </p>
    </div>
  </section>


  <InfoBar />

  <!-- Wat reinigen we -->
  <section class="bg-navy-900 py-24 md:py-36">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-start">

        <div>
          <h2 class="font-display font-extrabold text-2xl md:text-3xl text-white mb-6">Wat reinigen we?</h2>
          <p class="text-white leading-relaxed mb-5">
            We reinigen alle buitenoppervlakken die te maken krijgen met mos, algen, zwarte aanslag,
            vuil of weerinvloeden. Met aangepaste drukreiniging en de juiste behandelmiddelen
            verwijderen we aangroei zonder de ondergrond te beschadigen.
          </p>
          <p class="text-white leading-relaxed">
            Elk oppervlak vraagt een andere aanpak. Baksteen, natuursteen, beton, klinkers —
            we kiezen de methode die past bij het materiaal en de mate van vervuiling.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {[
            { label: 'Opritten', desc: 'Klinkers, tegels en beton — verwijdering van mos, aanslag en olievlekken.' },
            { label: 'Gevels', desc: 'Baksteen, arduin en pleister — reiniging van zwarte aanslag en vervuiling.' },
            { label: 'Terrassen', desc: 'Betontegels, hout en composiet — grondig en veilig gereinigd.' },
            { label: 'Verhardingen', desc: 'Paden, parkeerplaatsen en andere verharde buitenoppervlakken.' },
            { label: 'Mos en algen', desc: 'Effectieve verwijdering met behandeling om terugkeer te vertragen.' },
            { label: 'Aandacht voor afwerking', desc: 'We werken met oog voor voegen, randen en kwetsbare zones.' },
          ].map((item) => (
            <div class="bg-navy-800/60 border border-white/[0.07] hover:border-white/[0.13] rounded-xl p-5 transition-colors duration-200">
              <h3 class="font-display font-semibold text-white text-sm mb-2">{item.label}</h3>
              <p class="text-white text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- Detail afbeeldingen -->
  <section class="bg-navy-950 py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="relative rounded-2xl overflow-hidden bg-navy-800">
          <Image
            src={detail1}
            alt="Opritreiniging — resultaat voor en na"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="lazy"
            class="w-full h-72 md:h-80 object-cover object-left"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-950/22 to-transparent pointer-events-none"></div>
        </div>
        <div class="relative rounded-2xl overflow-hidden bg-navy-800">
          <Image
            src={detail2}
            alt="Gevelreiniging in Limburg"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="lazy"
            class="w-full h-72 md:h-80 object-cover object-right"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-950/22 to-transparent pointer-events-none"></div>
        </div>
      </div>
    </div>
  </section>


  <!-- Werkwijze -->
  <section class="bg-navy-900 py-24 md:py-36">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-display font-extrabold text-2xl md:text-3xl text-white mb-4">Onze werkwijze</h2>
        <p class="text-white max-w-lg mx-auto">Gericht op het oppervlak, met aandacht voor het resultaat.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { num: '01', title: 'Inspectie en offerte', desc: 'We beoordelen de oppervlakken ter plaatse en bepalen de geschikte aanpak. U ontvangt een duidelijke prijsopgave.' },
          { num: '02', title: 'Voorbereiding', desc: 'We beschermen de omgeving, beplanting en aanpalende oppervlakken voor we beginnen.' },
          { num: '03', title: 'Aangepaste reiniging', desc: 'Drukreiniging op de juiste druk voor het materiaal, aangevuld met behandelmiddelen waar nodig.' },
        ].map((step) => (
          <div class="text-center">
            <div class="w-12 h-12 rounded-full bg-navy-800 border border-navy-600/80 flex items-center justify-center mx-auto mb-4">
              <span class="font-display font-extrabold text-water-400">{step.num}</span>
            </div>
            <h3 class="font-display font-bold text-white mb-3">{step.title}</h3>
            <p class="text-white text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Praktische info -->
  <section class="bg-navy-950 py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="bg-navy-800/50 border border-white/[0.07] rounded-2xl p-8 md:p-10 flex flex-wrap gap-10 justify-center">
        {[
          { label: 'Voor wie', value: 'Particulieren en bedrijven' },
          { label: 'Oppervlakken', value: 'Steen, beton, klinkers, gevels' },
          { label: 'Werkgebied', value: "Bree, Limburg en omliggende regio's" },
          { label: 'Planning', value: 'Op afgesproken datum' },
        ].map((info) => (
          <div class="text-center">
            <div class="font-display font-bold text-white text-sm mb-1">{info.label}</div>
            <div class="text-white text-sm">{info.value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <ContactCTA />
</PageLayout>

<style>
  /*
    Afbeelding start ONDER de vaste navbar zodat het hoofd niet meer
    achter de navbar verdwijnt. bg-navy-950 vult de bovenste balk naadloos.
    Navbar: h-16 (64px) mobiel / h-20 (80px) desktop.
  */
  .hero-bg-img {
    top: 64px;
    height: calc(100% - 64px);
  }
  @media (min-width: 1024px) {
    .hero-bg-img {
      top: 80px;
      height: calc(100% - 80px);
    }
  }
</style>

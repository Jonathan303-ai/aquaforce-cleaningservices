---
const items = [
  {
    title: 'BETROUWBAAR',
    desc: 'Volledig verzekerd en professioneel',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2 3.5 6.5v4.8c0 5.1 3.7 9.9 8.5 11.2 4.8-1.3 8.5-6.1 8.5-11.2V6.5L12 2z"/>
      <path d="M9 12l2 2 4-4"/>
    </svg>`,
  },
  {
    title: 'B2B & PARTICULIER',
    desc: 'Diensten op maat voor elk type klant',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="8" width="8" height="13" rx="1"/>
      <rect x="10" y="3" width="12" height="18" rx="1"/>
      <path d="M5 12h2M5 16h2M13 7h2M13 11h2M13 15h2M17 7h1M17 11h1M17 15h1"/>
    </svg>`,
  },
  {
    title: 'ACTIEF IN HEEL VLAANDEREN',
    desc: 'Snelle service, altijd in uw regio',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2C8.1 2 5 5.1 5 9c0 5.5 7 13 7 13s7-7.5 7-13c0-3.9-3.1-7-7-7z"/>
      <circle cx="12" cy="9" r="2.2"/>
    </svg>`,
  },
  {
    title: 'KWALITEIT & DISCRETIE',
    desc: 'Premium service met oog voor detail',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2l2.8 5.7L21 9l-4.5 4.4 1.1 6.2L12 17l-5.6 2.6 1.1-6.2L3 9l6.2-1.3L12 2z"/>
    </svg>`,
  },
];
---

<div class="bg-navy-950 border-t border-white/[0.06]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4">
      {items.map((item, i) => (
        <div
          class:list={[
            'flex flex-col items-center text-center py-6 lg:py-8 px-3 sm:px-5 lg:px-6 gap-3 border-white/[0.08]',
            i % 2 === 0 ? 'border-r' : '',
            i < 2 ? 'border-b lg:border-b-0' : '',
            i < 3 ? 'lg:border-r' : '',
          ]}
        >
          <!-- Icoon in goud/brons -->
          <span class="infobar-icon">
            <Fragment set:html={item.icon} />
          </span>

          <!-- Titel -->
          <div>
            <p class="text-white font-display font-semibold text-[10px] sm:text-[11px] tracking-[0.18em] uppercase mb-1.5">
              {item.title}
            </p>
            <!-- Beschrijving -->
            <p class="text-slate-500 text-xs sm:text-sm leading-relaxed max-w-[180px] mx-auto">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .infobar-icon {
    color: #C9A84C;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .infobar-icon svg {
    width: 26px;
    height: 26px;
  }

  @media (min-width: 1024px) {
    .infobar-icon svg {
      width: 28px;
      height: 28px;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-aquaforce-clean-transparant.png';
import waterBg from '../assets/images/schoonmaakbedrijf-limburg.png';
import druppel from '../assets/images/gouden-druppel-schoonmaakbedrijf-limburg.webp';

const year = new Date().getFullYear();
---

<footer class="relative bg-navy-900 border-t border-navy-700/40 overflow-hidden">

  <!-- Decoratieve waterbranding overlay -->
  <div
    aria-hidden="true"
    class="absolute inset-0 pointer-events-none select-none footer-water-overlay"
  >
    <Image
      src={waterBg}
      alt=""
      widths={[768, 1280, 1536]}
      sizes="100vw"
      loading="lazy"
      class="w-full h-full object-cover object-center"
    />
  </div>

  <!-- Footer content — z-index boven overlay -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">

      <!-- Brand -->
      <div>
        <a
          href="/"
          class="inline-flex mb-6 transition-opacity duration-200 hover:opacity-90"
          aria-label="Aquaforce Cleaning Services — home"
        >
          <Image
            src={logo}
            alt="Aquaforce Cleaning Services"
            height={88}
            class="block w-auto object-contain footer-logo-img"
            loading="lazy"
          />
        </a>
        <p class="footer-brand-text">
          Professionele schoonmaakdiensten in Bree, Limburg en omliggende regio's. Betrouwbaar, grondig en op afgesproken tijdstippen.
        </p>
      </div>

      <!-- Diensten -->
      <div>
        <h3 class="font-display font-semibold text-sm mb-4 uppercase tracking-widest" style="color: #C9A84C;">Diensten</h3>
        <ul class="space-y-2.5">
          {[
            { label: 'Kantoorschoonmaak', href: '/kantoorschoonmaak' },
            { label: 'Ramen wassen', href: '/ramen-wassen' },
            { label: 'Oprit & gevelreiniging', href: '/oprit-en-gevelreiniging' },
          ].map((link) => (
            <li>
              <a href={link.href} class="inline-flex items-center gap-2 text-white hover:text-slate-300 text-sm transition-colors">
                <Image
                  src={druppel}
                  alt=""
                  aria-hidden="true"
                  width={9}
                  height={13}
                  class="shrink-0 object-contain h-[13px] w-auto"
                  loading="lazy"
                />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-display font-semibold text-sm mb-4 uppercase tracking-widest" style="color: #C9A84C;">Contact</h3>
        <address class="not-italic space-y-3 text-sm text-white">
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-water-400/40 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Cosijnstraat 15, 3960 Bree, België
          </p>
          <p>
            <a href="mailto:info@aquaforce.be" class="flex items-start gap-2 hover:text-slate-300 transition-colors">
              <svg class="w-4 h-4 mt-0.5 text-water-400/40 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              info@aquaforce.be
            </a>
          </p>
          <p>
            <a href="tel:+32465045504" class="flex items-start gap-2 hover:text-slate-300 transition-colors">
              <svg class="w-4 h-4 mt-0.5 text-water-400/40 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              +32 465 04 55 04
            </a>
          </p>
        </address>
      </div>
    </div>

    <div class="border-t border-navy-700/40 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-white text-sm">© {year} Aquaforce Cleaning Services. Alle rechten voorbehouden.</p>
      <div class="flex gap-6">
        <a href="/privacybeleid" class="text-white hover:text-slate-400 text-sm transition-colors">Privacybeleid</a>
        <a href="/algemene-voorwaarden" class="text-white hover:text-slate-400 text-sm transition-colors">Algemene voorwaarden</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Water overlay: PNG met alpha-transparantie.
     mix-blend-mode verwijderd — op zeer donkere achtergronden
     werkt screen blend averechts (donker×donker = nog donkerder).
     Directe opacity geeft meest voorspelbare en zichtbare result. */
  .footer-water-overlay {
    opacity: 0.52;
    mix-blend-mode: screen;
    filter: sepia(0.65) saturate(2) hue-rotate(5deg);
  }

  @media (max-width: 768px) {
    .footer-water-overlay {
      opacity: 0.38;
    }
  }

  .footer-brand-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #D1D5DB;
    background: rgba(11, 15, 20, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 10px;
    padding: 10px 14px;
    text-shadow: 0 1px 6px rgba(5, 7, 11, 0.80);
    display: inline-block;
    max-width: 100%;
  }

  .footer-logo-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
  }
</style>

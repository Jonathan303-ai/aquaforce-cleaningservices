---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-aquaforce.webp';

const year = new Date().getFullYear();
---

<footer class="bg-navy-900 border-t border-navy-700/40">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">

      <!-- Brand -->
      <div>
        <a href="/" class="inline-flex mb-5" aria-label="Aquaforce Cleaning Services — home">
          <Image
            src={logo}
            alt="Aquaforce Cleaning Services"
            height={60}
            class="block w-auto object-contain h-[60px] transition-opacity duration-200 hover:opacity-90"
            loading="lazy"
          />
        </a>
        <p class="text-slate-500 text-sm leading-relaxed">
          Professionele schoonmaakdiensten in Bree, Limburg en omliggende regio's. Betrouwbaar, grondig en op afgesproken tijdstippen.
        </p>
      </div>

      <!-- Diensten -->
      <div>
        <h3 class="font-display font-semibold text-white text-sm mb-4">Diensten</h3>
        <ul class="space-y-2.5">
          {[
            { label: 'Kantoorschoonmaak', href: '/kantoorschoonmaak' },
            { label: 'Ramen wassen', href: '/ramen-wassen' },
            { label: 'Oprit & gevelreiniging', href: '/oprit-en-gevelreiniging' },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-display font-semibold text-white text-sm mb-4">Contact</h3>
        <address class="not-italic space-y-3 text-sm text-slate-500">
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-water-400/40 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Bree, Limburg, België
          </p>
          <p>
            <a href="mailto:info@aquaforce.be" class="flex items-start gap-2 hover:text-slate-400 transition-colors">
              <svg class="w-4 h-4 mt-0.5 text-water-400/40 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              info@aquaforce.be
            </a>
          </p>
          <p>
            <a href="tel:+3200000000" class="flex items-start gap-2 hover:text-slate-400 transition-colors">
              <svg class="w-4 h-4 mt-0.5 text-water-400/40 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              +32 (0) XXX XX XX XX
            </a>
          </p>
        </address>
      </div>
    </div>

    <div class="border-t border-navy-700/40 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-slate-600 text-sm">© {year} Aquaforce Cleaning Services. Alle rechten voorbehouden.</p>
      <div class="flex gap-6">
        <a href="#" class="text-slate-600 hover:text-slate-400 text-sm transition-colors">Privacybeleid</a>
        <a href="#" class="text-slate-600 hover:text-slate-400 text-sm transition-colors">Algemene voorwaarden</a>
      </div>
    </div>
  </div>
</footer>

---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';

import heroImg from '../assets/images/kantoor-hero.webp';
import detail1 from '../assets/images/kantoor-detail-1.webp';
import detail2 from '../assets/images/kantoor-detail-2.webp';
---

<PageLayout
  title="Kantoorschoonmaak in Bree en Limburg | Aquaforce Cleaning Services"
  description="Professionele kantoorschoonmaak in Bree, Limburg en omliggende regio's. Dagelijkse of periodieke reiniging van bureaus, vergaderzalen, sanitair en keukens. Vraag een offerte aan."
>

  <!-- Hero met achtergrondafbeelding -->
  <section class="relative flex items-end overflow-hidden bg-navy-950" style="min-height: clamp(500px, 72vh, 700px);">

    <Image
      src={heroImg}
      alt="Professionele kantoorschoonmaak"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover select-none pointer-events-none"
      style="object-position: center top;"
    />

    <!-- Overlays — beeld zichtbaar bovenaan, tekst leesbaar onderaan -->
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-navy-950/82 via-navy-950/28 to-transparent"></div>
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-navy-950/50 via-navy-950/15 to-transparent"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full pt-36 pb-14 md:pt-44 md:pb-18">
      <nav aria-label="Breadcrumb" class="text-shadow-sm flex items-center gap-2 text-slate-400 text-sm mb-7">
        <a href="/" class="hover:text-slate-200 transition-colors">Home</a>
        <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M6.293 12.707a1 1 0 010-1.414L9.586 8 6.293 4.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
        <span class="text-slate-300">Kantoorschoonmaak</span>
      </nav>
      <p class="text-shadow-sm text-water-400 font-display font-semibold text-xs tracking-[0.25em] uppercase mb-4">Dienst</p>
      <h1 class="text-shadow-hero font-display font-extrabold text-4xl md:text-5xl lg:text-6xl text-white leading-tight mb-5 max-w-2xl">
        Kantoor&shy;schoonmaak
      </h1>
      <p class="text-shadow-sm text-slate-300/90 text-lg leading-relaxed max-w-xl">
        Een hygiënische werkomgeving is de basis van een professioneel bedrijf.
        Wij zorgen dat uw kantoor er altijd verzorgd uitziet.
      </p>
    </div>
  </section>

  <!-- Wat is inbegrepen -->
  <section class="bg-navy-900 py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-start">

        <div>
          <h2 class="font-display font-extrabold text-2xl md:text-3xl text-white mb-6">Wat valt er onder kantoorschoonmaak?</h2>
          <p class="text-slate-400 leading-relaxed mb-5">
            We reinigen alle ruimtes die deel uitmaken van uw kantooromgeving. Dagelijks, wekelijks
            of op een schema dat aansluit bij uw werkritme. Onze aanpak is systematisch en grondig —
            van de inkomhal tot de kleinste vergaderruimte.
          </p>
          <p class="text-slate-400 leading-relaxed">
            Waar nodig werken we buiten kantooruren, zodat uw team de volgende ochtend een
            frisse en nette werkplek aantreft zonder onderbreking van de dagelijkse werking.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {[
            { label: 'Bureaus en werkplekken', desc: 'Reinigen van bureau-oppervlakken, stoelen en werkmateriaal.' },
            { label: 'Vergaderzalen', desc: 'Tafels, stoelen, ramen en presentatiemateriaal.' },
            { label: 'Sanitair', desc: 'Volledige reiniging en desinfectie van toiletten en wastafels.' },
            { label: 'Keukens en pauzeruimtes', desc: 'Aanrechten, apparatuur, vloeren en afvalbeheer.' },
            { label: 'Ontvangstruimtes', desc: 'Wachtruimtes, receptie en inkomhallen.' },
            { label: 'Vloeren', desc: 'Stofzuigen, dweilen en behandeling van harde vloeren.' },
          ].map((item) => (
            <div class="bg-navy-800 border border-navy-600/50 rounded-xl p-5">
              <h3 class="font-display font-semibold text-white text-sm mb-2">{item.label}</h3>
              <p class="text-slate-500 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Detail afbeeldingen -->
  <section class="bg-navy-950 py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="relative rounded-2xl overflow-hidden">
          <Image
            src={detail1}
            alt="Professionele kantoorschoonmaak in detail"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="lazy"
            class="w-full h-72 md:h-80 object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-950/22 to-transparent pointer-events-none"></div>
        </div>
        <div class="relative rounded-2xl overflow-hidden">
          <Image
            src={detail2}
            alt="Schone en verzorgde kantooromgeving"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="lazy"
            class="w-full h-72 md:h-80 object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-950/22 to-transparent pointer-events-none"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Werkwijze -->
  <section class="bg-navy-900 py-20 md:py-28">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-display font-extrabold text-2xl md:text-3xl text-white mb-4">Onze aanpak</h2>
        <p class="text-slate-400 max-w-lg mx-auto">Transparant van begin tot einde.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { num: '01', title: 'Offerte op maat', desc: 'We bezoeken uw kantoor of bespreken uw wensen telefonisch. U ontvangt een duidelijke prijsopgave.' },
          { num: '02', title: 'Afspraken vastleggen', desc: 'Frequentie, tijdstip, specifieke ruimtes — alles wordt concreet vastgelegd.' },
          { num: '03', title: 'Professionele uitvoering', desc: 'Ons team werkt met professioneel materiaal en houdt rekening met de werkomgeving.' },
        ].map((step) => (
          <div class="text-center">
            <div class="w-12 h-12 rounded-full bg-navy-800 border border-navy-600/80 flex items-center justify-center mx-auto mb-4">
              <span class="font-display font-extrabold text-water-400">{step.num}</span>
            </div>
            <h3 class="font-display font-bold text-white mb-3">{step.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Praktische info -->
  <section class="bg-navy-950 py-12">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="bg-navy-800 border border-navy-600/50 rounded-2xl p-7 flex flex-wrap gap-8 justify-center">
        {[
          { label: 'Frequentie', value: 'Dagelijks, wekelijks of op maat' },
          { label: 'Timing', value: 'Flexibel — ook buiten kantooruren' },
          { label: 'Werkgebied', value: "Bree, Limburg en omliggende regio's" },
          { label: 'Materiaal', value: 'Professioneel en hygiënisch' },
        ].map((info) => (
          <div class="text-center">
            <div class="font-display font-bold text-white text-sm mb-1">{info.label}</div>
            <div class="text-slate-400 text-sm">{info.value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA />
</PageLayout>
